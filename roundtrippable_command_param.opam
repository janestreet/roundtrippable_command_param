opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/roundtrippable_command_param"
bug-reports: "https://github.com/janestreet/roundtrippable_command_param/issues"
dev-repo: "git+https://github.com/janestreet/roundtrippable_command_param.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/roundtrippable_command_param/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.2.0"}
  "base"
  "core"
  "core_kernel"
  "file_path"
  "ppx_bench"
  "ppx_expect"
  "ppx_jane"
  "ppx_module_timer"
  "ppxlib_jane"
  "profunctor"
  "univ_map"
  "variantslib"
  "dune"             {>= "3.17.0"}
  "ppxlib"           {= "0.33.0+ox"}
]
available: arch != "arm32" & arch != "x86_32"
synopsis: "A library for building Command.Param.t values that can roundtrip to command-line arguments"
description: "
Roundtrippable_command_param provides utilities for creating Command.Param.t values that can be converted back to command-line arguments, enabling serialization of command parameters.
"
