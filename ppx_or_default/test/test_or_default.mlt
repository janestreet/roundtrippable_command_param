#print_line_numbers true

#reset_line_numbers_after_expect true

type not_a_record = int [@@deriving or_default]

[%%expect
  {|
Line 1, characters 0-47:
Error: Unsupported use: you can only use [@deriving or_default] on records
|}]

type variant_also_doesn't_work =
  | Hello
  | World
[@@deriving or_default]

[%%expect
  {|
Line 1, characters 0-76:
Error: Unsupported use: you can only use [@deriving or_default] on records
|}]

type hello = { hello : string }
and world = { world : string } [@@deriving or_default]

[%%expect
  {|
Line 1, characters 0-86:
Error: Unsupported use: you cannot use [@deriving or_default] on multiple recursive type definitions (type a = ... and b = ... )
|}]


module _ = struct
  type t = string

  module _ = struct
    type nonrec t = { t : t } [@@deriving or_default]
  end
end

[%%expect
  {|
Line 5, characters 4-53:
Error: This expression has type string but an expression was expected of type
         derived_on
|}]

(* [@default.drop_default*] requires a [@default <value>] on the same field. *)
type missing_default = { num : int [@default.drop_default.equal] } [@@deriving or_default]

[%%expect
  {|
Line 1, characters 25-64:
Error: Unsupported use: [@default.drop_default*] requires [@or_default.default <value>] on the same field.
|}]

(* At most one drop_default attribute per field. *)
type two_drop_defaults =
  { num : int [@default 5] [@default.drop_default.compare] [@default.drop_default.equal] }
[@@deriving or_default]

[%%expect
  {|
Line 2, characters 4-88:
Error: Unsupported use: at most one of [@default.drop_default <equal>], [@default.drop_default.compare], or [@default.drop_default.equal] may be used on the same field.
|}]

(* drop_default cannot be combined with [@with_defaults]. *)
module Inner = struct
  type t = { x : int [@default 0] } [@@deriving or_default]
end

type drop_default_with_defaults =
  { inner : Inner.t [@with_defaults] [@default.drop_default.equal] }
[@@deriving or_default]

[%%expect
  {|
Line 6, characters 20-36:
Error: Unsupported use: [@default.drop_default*] cannot be combined with [@or_default.with_defaults].
|}]
